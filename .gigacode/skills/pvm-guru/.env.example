# pvm-guru — доступы к четырём системам
#
# Скопируйте в ~/.swtr-review.env и заполните. Все скрипты навыка читают именно
# этот путь по умолчанию (флаг --env-file его переопределяет):
#
#   cp .env.example ~/.swtr-review.env      # macOS / Linux
#   copy .env.example %USERPROFILE%\.swtr-review.env    # Windows (cmd)
#
# Заполнять всё не нужно: каждая система работает независимо, незаполненную
# доктор покажет как "no credential" и остальные проверит.
#
# Проверка после заполнения — она же единственный способ узнать, что кред живой:
#   python3 scripts/guru_doctor.py
#
# ВАЖНО ПРО КОДИРОВКУ ФАЙЛА (Windows): сохраняйте в UTF-8 без BOM. В блокноте
# «Файл → Сохранить как → Кодировка: UTF-8», НЕ «Юникод» (это UTF-16, файл не
# прочитается). Доктор печатает распознанную кодировку первой же строкой.
# Пароль со спецсимволами (} % # * & $ ! \) экранировать не нужно — внутри
# двойных кавычек они сохраняются как есть.
#
# Файл с секретами лежит в домашнем каталоге и в репозиторий не попадает.
# Не коммитьте заполненную копию и не печатайте значения в консоль.


# ─────────────────────────────────────────────────────────────────────────────
# 1. Task Tracker (SWTR) — задачи, вики, TMS. portal.works.prod.sbt
# ─────────────────────────────────────────────────────────────────────────────
# Нужна ОДНА из двух схем. Если заданы обе, выигрывает Basic.
#
# Схема А — доменные логин и пароль. Работает сразу, но умирает при каждой
# смене доменного пароля: доктор покажет вердикт stale_password.
SWTR_BASIC_AUTH="login:password"
#
# Схема Б — персональный токен портала. Переживает смену доменного пароля, но
# живёт недолго: это JWT с полем exp, и после истечения запросы падают с «JWT
# token verification failed: 'exp' claim expired». Тогда токен выпускают заново —
# схемой «поставил и забыл» он не является. Как получить:
#   1. открыть https://portal.works.prod.sbt/ssd/privileges (авторизоваться);
#   2. страница скачает файл privileges — открыть его;
#   3. пролистать вниз до строки [Authorization] header: Bearer;
#   4. скопировать токен после неё БЕЗ слова Bearer — схему скрипт добавит сам.
# Тот же токен принимает и SourceControl (см. раздел 2).
# SWTR_BEARER_TOKEN="<токен портала>"
#
# Готовое значение заголовка целиком — если токен выдан с нестандартной схемой.
# SWTR_AUTHORIZATION="Bearer <токен>"
#
# Дополнительная cookie, уходит с каждым запросом Task Tracker. Нужна ТОЛЬКО
# вместе с Bearer-токеном и только если без неё шлюз портала токен не принял:
# это 401 либо 500 unknown_error с текстом «Error auth by direct-auth».
# Со схемой А (Basic) не ставить никогда — вместе с паролем эта cookie даёт
# 403 SWTR_ACCESS_DENIED_ERROR.
# SWTR_COOKIE="api_swtr_as21=true"
#
# Адрес инстанса. По умолчанию https://portal.works.prod.sbt/swtr — менять
# только если у вас отдельный контур.
# SWTR_BASE_URL="https://portal.works.prod.sbt/swtr"
#
# Юнит, по которому доктор проверяет чтение. Смените, если CRPV-35498 вам
# не виден: 404 на нём — это не отказ авторизации, но и не подтверждение.
# SWTR_PROBE_UNIT="CRPV-35498"
#
# Ваш логин в трекере — не секрет. Его берут «мои задачи» (`--me`) и профиль
# умолчаний. Переменная сильнее профиля и слабее явного флага; не задана —
# логин ищется в профиле, затем в USER, затем в логине SWTR_BASIC_AUTH.
# SWTR_LOGIN="familia.i.o"


# ─────────────────────────────────────────────────────────────────────────────
# 2. SourceControl — репозитории, код, Pull Request. portal.works.prod.sbt
# ─────────────────────────────────────────────────────────────────────────────
# Отдельный кред, а не тот же самый: креды SWTR сюда НЕ подставляются молча,
# иначе один протухший пароль устраивает 401-шторм сразу в двух системах.
SOURCE_CONTROL_BASIC_AUTH="login:password"
#
# Либо токен. Выпускается там же, где токен портала (раздел 1), а также через
# SourceControl → Settings → Access Tokens.
# SOURCE_CONTROL_BEARER_TOKEN="<токен>"
#
# Осознанное разрешение переиспользовать кред SWTR, если он действительно один
# и тот же. Без этой строки переиспользования не будет.
# SOURCE_CONTROL_REUSE_SWTR_AUTH=1
#
# Проект, по которому доктор проверяет чтение. Смените на видимый вам.
# SOURCE_CONTROL_PROBE_TENANT="22f434fb-0355-42a1-ac25-011074a20a2d"
# SOURCE_CONTROL_PROBE_PROJECT="pvm"
#
# Tenant и проект по умолчанию — не секрет. Их подставляют поиск по коду и
# создание Pull Request, когда флаг не назван: переменная сильнее профиля
# (source_control.tenant / source_control.project) и слабее явного флага.
# Не задано ни там, ни там — команда отказывает, как и раньше.
# SOURCE_CONTROL_TENANT="22f434fb-0355-42a1-ac25-011074a20a2d"
# SOURCE_CONTROL_PROJECT="pvm"
#
# Ваш логин в SourceControl — не секрет. Его читает ревью Pull Request, чтобы
# не поднимать заново замечания, которые вы сами уже закрыли: порядок —
# флаг --login (логин, названный вами в запросе), затем SOURCE_CONTROL_LOGIN,
# SC_LOGIN и SWTR_LOGIN, и только потом --profile-login (туда навык подставляет
# логин из профиля умолчаний). Пусто везде — логин неизвестен, и отчёт остаётся
# прежним.
# SOURCE_CONTROL_LOGIN="familia.i.o"
#
# Ревьюеры, которые проставляются в создаваемый Pull Request, через запятую.
# SOURCE_CONTROL_DEFAULT_REVIEWERS="ivanov-ii,petrov-pp"


# ─────────────────────────────────────────────────────────────────────────────
# 3. Confluence — вики sberworks.ru
# ─────────────────────────────────────────────────────────────────────────────
# Basic здесь отклоняется сервером: работает ТОЛЬКО персональный токен (PAT).
# Выпустить: Confluence → Профиль → Personal Access Tokens → Create token.
# CONFLUENCE_BEARER_TOKEN="<Confluence PAT>"
#
# Один токен на оба приложения sberworks, если он у вас общий.
# SBERWORKS_TOKEN="<PAT>"


# ─────────────────────────────────────────────────────────────────────────────
# 4. Jira — задачи sberworks.ru
# ─────────────────────────────────────────────────────────────────────────────
# Отдельный токен от Confluence, даже на том же домене: Confluence и Jira —
# разные приложения, и чужой токен даёт 401.
# Выпустить: Jira → Профиль → Personal Access Tokens → Create token.
# JIRA_BEARER_TOKEN="<Jira PAT>"


# ─────────────────────────────────────────────────────────────────────────────
# TLS
# ─────────────────────────────────────────────────────────────────────────────
# Включать, только если корпоративный CA не в доверенных и связаться с ним
# иначе не получается. Правильное решение — добавить корневой сертификат в
# доверенные (SSL_CERT_FILE с бандлом), а не выключать проверку.
# Флаг ПОСИСТЕМНЫЙ: SWTR_INSECURE_SKIP_TLS_VERIFY не действует на confluence и
# jira — у них свои.
# SWTR_INSECURE_SKIP_TLS_VERIFY=1
# SOURCE_CONTROL_INSECURE_SKIP_TLS_VERIFY=1
# CONFLUENCE_INSECURE_SKIP_TLS_VERIFY=1
# JIRA_INSECURE_SKIP_TLS_VERIFY=1
